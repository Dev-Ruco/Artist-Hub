# Aplicação exclusiva de Mr. Bow; backend independente do Supabase.
# Preencher no Coolify em Environment Variables; não guardar valores reais no Git.
PORTA_API=8080
SUPABASE_ENDERECO=https://supabase.datacenterhub.tech
SUPABASE_CHAVE_ANONIMA=COLOCAR_CHAVE_PUBLICA_ANON
ORIGENS_PERMITIDAS=http://localhost:8081,http://localhost:19006
# O servidor só arranca com uma chave anon real; nenhuma chave é guardada no Git.
# Nunca usar SERVICE_ROLE_KEY, JWT_SECRET ou password da base de dados aqui.
