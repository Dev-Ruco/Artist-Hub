# Use o URL público e a chave publicável/anon do seu Supabase.
# Nunca coloque service_role, JWT secret ou credenciais financeiras aqui.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-SUPABASE.example.com
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=COLOCAR_CHAVE_PUBLICAVEL

# Opcional: restringe o aplicativo a um único artista (white-label).
# Deixe em branco para modo multiartista no piloto.
EXPO_PUBLIC_ARTIST_SLUG=
