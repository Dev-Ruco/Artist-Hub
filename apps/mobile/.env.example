# Novo modo: a aplicação móvel comunica EXCLUSIVAMENTE com a API Java.
# Configurar somente depois de o backend estar publicado por HTTPS.
# Deixar vazio para manter temporariamente a integração legada.
EXPO_PUBLIC_API_URL=

# Integração legada com Supabase (apenas enquanto a API Java não estiver publicada).
# Em modo API, a aplicação não precisa da chave anon.
EXPO_PUBLIC_SUPABASE_URL=https://supabase.datacenterhub.tech
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Identidade exclusiva da aplicação
EXPO_PUBLIC_ARTIST_SLUG=mr-bow
EXPO_PUBLIC_ARTIST_NAME=Mr. Bow
