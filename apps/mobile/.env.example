# Chaves PUBLICAVEIS do Supabase, somente quando o backend estiver configurado.
# Nunca expor service_role, segredos financeiros ou passwords neste ficheiro.
EXPO_PUBLIC_SUPABASE_URL=https://SEU-SUPABASE.example.com
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=COLOCAR_CHAVE_PUBLICAVEL

# Aplicacao EXCLUSIVA de Mr. Bow.
# Para uma futura app de outro artista, mudar estas variaveis no build dessa app.
EXPO_PUBLIC_ARTIST_SLUG=mr-bow
EXPO_PUBLIC_ARTIST_NAME=Mr. Bow
