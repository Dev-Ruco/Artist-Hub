{
  "expo": {
    "name": "Artist Hub - Piloto",
    "slug": "artist-hub-piloto",
    "scheme": "artisthub",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#080A0F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mz.artistplatform.pilot"
    },
    "android": {
      "package": "mz.artistplatform.pilot",
      "adaptiveIcon": { "backgroundColor": "#080A0F" }
    },
    "plugins": ["expo-router", "expo-splash-screen"],
    "experiments": { "typedRoutes": true },
    "extra": { "pilotArtistSlug": "artista-piloto" }
  }
}
