{
  "expo": {
    "name": "Mr. Bow",
    "slug": "ruco",
    "scheme": "mrbow",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "backgroundColor": "#080A0F",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "mz.mrbow.app"
    },
    "android": {
      "package": "mz.mrbow.app",
      "adaptiveIcon": {
        "backgroundColor": "#080A0F"
      }
    },
    "plugins": [
      "expo-router",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "pilotArtistSlug": "mr-bow"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Mr. Bow"
    },
    "owner": "ruco222"
  }
}
